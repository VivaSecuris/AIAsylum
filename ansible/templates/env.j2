# API Keys
OPENAI_API_KEY={{ openai_api_key | default('') }}
ANTHROPIC_API_KEY={{ anthropic_api_key | default('') }}
GOOGLE_API_KEY={{ google_api_key | default('') }}

# Ollama Configuration
OLLAMA_BASE_URL={{ ollama_base_url | default('http://localhost:11434') }}

# Database
DATABASE_URL={{ database_url }}

# Security
API_SECRET_KEY={{ api_secret_key | default('change-me-in-production') }}
JWT_SECRET_KEY={{ jwt_secret_key | default('change-me-in-production') }}
API_KEY_HMAC_SECRET={{ api_key_hmac_secret | default('change-me-in-production') }}
API_KEYS={{ api_keys | default('') }}
REQUIRE_AUTH={{ require_auth | default('true') }}
SESSION_COOKIE_SECURE={{ session_cookie_secure | default('true') }}

# CORS
CORS_ORIGINS={{ cors_origins | default('http://localhost:3000,http://localhost:8000') }}

# Rate Limiting
RATE_LIMIT_PER_MINUTE={{ rate_limit_per_minute | default(60) }}

# Request Limits
MAX_REQUEST_SIZE_MB={{ max_request_size_mb | default(10) }}

# Logging
LOG_LEVEL={{ log_level | default('INFO') }}
LOG_FORMAT={{ log_format | default('json') }}

# Deep Analysis
ENABLE_PROMPT_DIFFERENTIAL_ANALYSIS={{ enable_prompt_differential_analysis | default('false') }}
ENABLE_ACTIVATION_PATCHING={{ enable_activation_patching | default('false') }}
ENABLE_COT_DETECTION={{ enable_cot_detection | default('false') }}

# RAG
ENABLE_RAG={{ enable_rag | default('false') }}
OLLAMA_EMBEDDING_MODEL={{ ollama_embedding_model | default('nomic-embed-text') }}
