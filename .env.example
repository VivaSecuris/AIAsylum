# API Keys (at least one provider required, or use Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama Configuration (no API keys needed)
OLLAMA_BASE_URL=http://localhost:11434

# Database
DATABASE_URL=sqlite:///./data/aiasylum.db
# For PostgreSQL: postgresql://user:password@localhost:5432/aiasylum
# For TimescaleDB + pgvector: postgresql://user:password@localhost:5432/aiasylum
# Required by docker compose. Unused by the default SQLite setup.
POSTGRES_PASSWORD=

# Security
API_SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
API_KEY_HMAC_SECRET=change-me-in-production
API_KEYS=  # Comma-separated list of API keys for API key auth

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Request Limits
MAX_REQUEST_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Deep Analysis (disabled by default for performance)
ENABLE_PROMPT_DIFFERENTIAL_ANALYSIS=false
ENABLE_ACTIVATION_PATCHING=false
ENABLE_COT_DETECTION=false

# RAG (optional)
ENABLE_RAG=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Authentication on every API route (api/security.py). Off for local dev.
# scripts/remote_session.sh turns it on for a remote box and generates the
# key and secret there; the API refuses to start with it on and either missing.
REQUIRE_AUTH=false
# Only true behind HTTPS; over an SSH tunnel the browser sees plain localhost.
SESSION_COOKIE_SECURE=false
